# 数据库配置
DATABASE_URL=postgresql://user:password@localhost:5432/exam_hub

# Redis配置
REDIS_URL=redis://localhost:6379/0

# Elasticsearch配置
ELASTICSEARCH_URL=http://localhost:9200

# MinIO配置
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_BUCKET_NAME=exam-hub

# Unity2.ai API配置（用于AI功能）
# ⚠️ 建议通过管理后台 /admin/ai-providers 添加到数据库（加密存储），而非写在此处
# 以下环境变量仅作为数据库无配置时的回退
UNITY2_API_KEY=your_unity2_api_key

# Tavily搜索API（可选，用于在线题源搜索）
# ⚠️ 建议通过管理后台 /admin/search-providers 添加到数据库（加密存储），而非写在此处
TAVILY_API_KEY=your_tavily_api_key
# Tavily SDK 的自定义 base_url（不要填写 /search 路径）
TAVILY_API_URL=https://your-search-gateway.example.com

# 自建搜索服务配置（可选，支持 SearXNG 等）
# 支持接口: GET /search, GET /image, GET /google/search, GET /mega/search, GET /extract
SEARCH_API_URL=https://your-search-service.example.com
SEARCH_API_KEY=your_search_api_key

# 额外允许的题源域名（逗号分隔，可选）
QUESTION_SOURCE_DOMAINS=
UNITY2_MODEL=claude-sonnet-4-6
UNITY2_BASE_URL=https://api.unity2.ai/v1

# JWT配置
# ⚠️ 生产环境必须使用至少 32 位随机字符串，如: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_secret_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_RATE_LIMIT_PER_MINUTE=10
PASSWORD_RESET_RATE_LIMIT_PER_MINUTE=3
EXTERNAL_SEARCH_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_MINUTE=5
PASSWORD_RESET_EXPIRE_MINUTES=15

# 邮件配置（生产环境密码重置）
# ⚠️ 邮件密码不要提交到版本控制，仅在 .env 中配置
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# 前端地址
FRONTEND_URL=http://localhost:3000

# 应用配置
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
